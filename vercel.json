{
  "services": {
    "dashboard": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile",
      "command": ["python", "-m", "waitress", "--listen=0.0.0.0:80", "--threads=4", "cloud_app:app"]
    },
    "dispatch": {
      "root": "dispatch",
      "bindings": [{"type":"service","service":"dashboard","format":"url","env":"PICASSO_CONTAINER_URL"}],
      "functions": {
        "api/consume.mjs": {
          "maxDuration": 300,
          "experimentalTriggers": [{"type":"queue/v2beta","topic":"picasso-collection"}]
        }
      }
    }
  },
  "rewrites": [
    {"source":"/api/collect","destination":{"service":"dispatch"}},
    {"source":"/(.*)","destination":{"service":"dashboard"}}
  ]
}
