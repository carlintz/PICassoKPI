{
  "services": {
    "dashboard": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    },
    "dispatch": {
      "root": "dispatch",
      "bindings": [
        {
          "type": "service",
          "service": "dashboard",
          "format": "url",
          "env": "PICASSO_CONTAINER_URL"
        }
      ],
      "functions": {
        "app/api/queues/consume/route.js": {
          "maxDuration": 300,
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "picasso-collection"
            }
          ]
        }
      },
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/collect",
      "destination": {
        "service": "dispatch"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "dashboard"
      }
    }
  ]
}
