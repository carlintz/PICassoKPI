{
  "framework": null,
  "buildCommand": "python3 build-vercel.py",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/backend?route="
    },
    {
      "source": "/api/:path*",
      "destination": "/api/backend?route=api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/api/backend?route=images/:path*"
    },
    {
      "source": "/seed-images/:path*",
      "destination": "/api/backend?route=seed-images/:path*"
    }
  ]
}
